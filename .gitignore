dist/
node_modules/
__pycache__/

# The Android wrapper is generated, not authored: www/ is a copy of dist/,
# android/ is scaffolded from capacitor.config.ts, and apk/ is the output.
tools/apk/www/
tools/apk/android/
# Rooted. Unanchored, `apk/` matches a directory of that name at any depth —
# including tools/apk/, which is the wrapper itself and has to be committed.
/apk/

# Merged uploads from "Share your data" — personal data, never committed.
/mindbuild-dataset/

# Antiphon is local-only: voice takes and session recordings never enter the repo.
# (The app itself caches them in IndexedDB; this only guards against stray copies.)
apps/antiphon/voices/
apps/antiphon/recordings/
apps/antiphon/*.webm
apps/antiphon/*.wav
apps/antiphon/*.mp3
